NODE_ENV=development
PORT=5001

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Safe mode disables external deps and DB strictness
SAFE_MODE=true

# Database (default to sqlite for interviews)
DB_DIALECT=sqlite
SQLITE_STORAGE=./dev.sqlite
DB_HOST=localhost
DB_NAME=bxdp
DB_USER=bxdp
DB_PASSWORD=changeme

# Auth/Token secrets (change for real deployments)
JWT_SECRET=change-me
DB_KEY=change-me
RESET_KEY=change-me-reset
INVITE_KEY=change-me-invite

# Email (mock by default)
EMAIL_PROVIDER=mock
DEV_EMAIL_USER=demo@example.com
EMAIL_PASSWORD=dummy-password
TEST_EMAIL_TO=demo@example.com

# Storage (mock by default)
STORAGE_PROVIDER=mock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=_sanitized_
AWS_SECRET_ACCESS_KEY=_sanitized_
ACCESS_KEY=_sanitized_
SECRET_KEY=_sanitized_
BUCKET_NAME=_sanitized_
CUSTOM_DOMAIN=http://localhost:5001/mock/
